# ---------------------------------------------------------------------------
# TryOn AI engine — copy to .env and fill in.
#   cp services/api/.env.example services/api/.env
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Public base URL of this API. Used to build absolute URLs for stored images,
# so it must be reachable from the merchant's browser.
PUBLIC_BASE_URL=http://localhost:4000

# --- Database -------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/tryon

# --- AI provider ----------------------------------------------------------
# openai = real generation via gpt-image-1
# mock   = returns the visitor's own photo after a delay, no API calls, no cost.
#          Use this to develop the UI without burning credits.
AI_PROVIDER=mock

# Required when AI_PROVIDER=openai. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Image model used for the try-on composite.
OPENAI_IMAGE_MODEL=gpt-image-1
# auto | low | medium | high — higher costs more and takes longer.
OPENAI_IMAGE_QUALITY=medium
# 1024x1024 | 1024x1536 | 1536x1024 | auto. Portrait suits full-body shots.
OPENAI_IMAGE_SIZE=1024x1536
# Hard cap on how long a single generation may run, in milliseconds.
AI_TIMEOUT_MS=120000

# Simulated latency for the mock provider, in milliseconds.
MOCK_DELAY_MS=2500

# --- Storage --------------------------------------------------------------
# cloudinary = upload to Cloudinary (recommended — survives redeploys)
# local      = write to disk under services/api/storage and serve via /files
STORAGE_DRIVER=cloudinary
MAX_UPLOAD_BYTES=8388608

# Only used when STORAGE_DRIVER=local.
STORAGE_DIR=storage

# --- Cloudinary -----------------------------------------------------------
# Either set CLOUDINARY_URL on its own (it encodes all three values), or set
# the three below. Both are on your Cloudinary dashboard under Account Details.
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Folder prefix for everything this service uploads.
CLOUDINARY_FOLDER=tryon

# authenticated = assets need a signed URL; nobody can guess their address.
# public        = plain res.cloudinary.com URLs, cacheable but publicly readable.
# Shopper body photos are personal data, so authenticated is the default.
CLOUDINARY_DELIVERY=authenticated

# --- Retention ------------------------------------------------------------
# Visitor photos are deleted this many days after upload. Generations follow
# the same clock. Set to 0 to keep forever (see README before doing that).
PHOTO_RETENTION_DAYS=30

# --- Security -------------------------------------------------------------
# Bearer token for POST /v1/admin/merchants, the one route that cannot be
# authenticated with a merchant key because it is what creates merchants.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_BOOTSTRAP_TOKEN=

# Comma-separated origins allowed to call /v1/admin/*. The widget routes use
# each merchant's own allowedOrigins list instead.
ADMIN_CORS_ORIGINS=http://localhost:3000

# Max widget requests per IP per minute.
RATE_LIMIT_PER_MINUTE=60
# Max try-on generations per visitor per hour.
GENERATION_LIMIT_PER_HOUR=20
