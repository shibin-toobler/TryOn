# ---------------------------------------------------------------------------
# TryOn AI engine — copy to .env and fill in.
#   cp services/api/.env.example services/api/.env
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Public base URL of this API. Used to build absolute URLs for stored images,
# so it must be reachable from the merchant's browser.
PUBLIC_BASE_URL=http://localhost:4000

# --- Database -------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/tryon

# --- AI provider ----------------------------------------------------------
# openai = real generation via gpt-image-1
# mock   = returns the visitor's own photo after a delay, no API calls, no cost.
#          Use this to develop the UI without burning credits.
AI_PROVIDER=mock

# Required when AI_PROVIDER=openai. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Image model used for the try-on composite.
# gpt-image-1 | gpt-image-1.5 | gpt-image-2 | gpt-image-1-mini
OPENAI_IMAGE_MODEL=gpt-image-2

# auto | low | medium | high — how finely the output is rendered.
# This is the cost dial: cut it first.
OPENAI_IMAGE_QUALITY=medium

# 1024x1024 | 1024x1536 | 1536x1024 | auto.
# auto keeps the shopper photo's own aspect ratio. Forcing a fixed size makes the
# model re-compose the shot, which is a large part of why backgrounds get rebuilt.
OPENAI_IMAGE_SIZE=auto

# How much of the shopper survives the edit — the face above all. NOT the same
# dial as quality: quality is render finesse, fidelity is whether it is still
# them. Only the gpt-image-1 family accepts it; gpt-image-2 returns a 400, so the
# provider gates on the model name. Set to "" to disable everywhere.
#
# COST: measured on one render, high took gpt-image-1 from 646 to 13,126 input
# image tokens — $0.071 to $0.198. Expensive, and worth it on that family.
OPENAI_IMAGE_FIDELITY=high
# Hard cap on how long a single generation may run, in milliseconds.
AI_TIMEOUT_MS=120000

# Simulated latency for the mock provider, in milliseconds.
MOCK_DELAY_MS=2500

# --- Pricing --------------------------------------------------------------
# USD per 1M tokens. gpt-image-1 bills three meters separately, and the image
# output is what actually costs money. Every render is priced with these rates
# at the moment it runs and the result is stored on the generation, so changing
# a rate here affects new renders only — history is never rewritten.
#
# CHECK THESE against https://openai.com/api/pricing/ before trusting a report.
PRICE_TEXT_INPUT_PER_MTOK=5
PRICE_IMAGE_INPUT_PER_MTOK=10
PRICE_IMAGE_OUTPUT_PER_MTOK=40

# Display only, for the ₹ figures in GET /v1/admin/usage. The ledger is USD.
USD_TO_INR=88

# --- Storage --------------------------------------------------------------
# s3         = Amazon S3 (recommended — survives redeploys)
# cloudinary = upload to Cloudinary
# local      = write to disk under services/api/storage and serve via /files
STORAGE_DRIVER=s3
MAX_UPLOAD_BYTES=8388608

# Only used when STORAGE_DRIVER=local.
STORAGE_DIR=storage

# --- S3 -------------------------------------------------------------------
# ap-south-1 = Mumbai, ap-south-2 = Hyderabad. Keep the bucket in the same
# region as the API: every render reads the photo back out of it.
AWS_REGION=ap-south-1
S3_BUCKET=

# Leave both blank on EC2/ECS/Lambda to use the instance's IAM role, which is
# always better than a long-lived key sitting in a file. Locally, create an IAM
# user with only s3:PutObject, s3:GetObject and s3:DeleteObject on this bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Key prefix inside the bucket, so one bucket can hold more than this app.
S3_PREFIX=tryon

# presigned = bucket stays private, URLs are signed and expire (the default,
#             and the right one for photographs of real people)
# public    = plain, cacheable URLs; only for a bucket that is genuinely meant
#             to be world-readable, usually one fronted by CloudFront
S3_DELIVERY=presigned
# How long a presigned URL stays valid. Max 604800 (7 days) — SigV4's limit.
S3_URL_EXPIRY_SECONDS=3600

# Optional: CloudFront domain to serve from instead of the bucket host.
# Only used when S3_DELIVERY=public.
S3_PUBLIC_BASE_URL=

# Optional: point at MinIO or any S3-compatible service instead of AWS.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# --- Cloudinary -----------------------------------------------------------
# Either set CLOUDINARY_URL on its own (it encodes all three values), or set
# the three below. Both are on your Cloudinary dashboard under Account Details.
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Folder prefix for everything this service uploads.
CLOUDINARY_FOLDER=tryon

# authenticated = assets need a signed URL; nobody can guess their address.
# public        = plain res.cloudinary.com URLs, cacheable but publicly readable.
# Shopper body photos are personal data, so authenticated is the default.
CLOUDINARY_DELIVERY=authenticated

# --- Retention ------------------------------------------------------------
# Visitor photos are deleted this many days after upload. Generations follow
# the same clock. Set to 0 to keep forever (see README before doing that).
PHOTO_RETENTION_DAYS=30

# --- Security -------------------------------------------------------------
# Bearer token for POST /v1/admin/merchants, the one route that cannot be
# authenticated with a merchant key because it is what creates merchants.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_BOOTSTRAP_TOKEN=

# Comma-separated origins allowed to call /v1/admin/*. The widget routes use
# each merchant's own allowedOrigins list instead.
ADMIN_CORS_ORIGINS=http://localhost:3000

# Max widget requests per IP per minute.
RATE_LIMIT_PER_MINUTE=60
# Max try-on generations per visitor per hour.
GENERATION_LIMIT_PER_HOUR=20
